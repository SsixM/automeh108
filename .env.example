# Copy to .env or export these variables in the Aurorix control panel.
# Never commit real values.

# Required: Telegram bot token from BotFather.
TELEGRAM_BOT_TOKEN=

# Required: comma-separated Telegram user IDs allowed to use the bot.
# Example: 123456789,987654321
ALLOWED_TELEGRAM_IDS=

# Required: fine-grained GitHub token with Contents: Read and write
# for the single data repository only.
GITHUB_TOKEN=

# Required for journal photo recognition: Google AI Studio API key.
GEMINI_API_KEY=

# Repository settings (defaults are suitable for this project).
GITHUB_REPOSITORY=SsixM/automeh108
GITHUB_BRANCH=main
DATA_DIR=data

# Optional: VK community id (digits only, without minus) and service token.
# Without these the bot still accepts a forwarded PDF with replacements.
VK_GROUP_ID=
VK_ACCESS_TOKEN=

# Optional overrides.
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash
# GEMINI_RPM_LIMIT=5
# GEMINI_RPD_LIMIT=20
# GEMINI_TPM_LIMIT=250000
# BOT_STATE_FILE=bot_state.local.json
# LOG_LEVEL=INFO
