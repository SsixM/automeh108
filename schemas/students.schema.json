{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "students.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "generatedAt", "group", "students"],
  "properties": {
    "schemaVersion": {"const": 1},
    "revision": {"type": "string", "minLength": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "group": {"const": "108М"},
    "students": {
      "type": "array",
      "minItems": 33,
      "maxItems": 33,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["studentId", "name", "englishGroup", "aliases"],
        "properties": {
          "studentId": {"type": "string", "pattern": "^s[0-9]{2}$"},
          "name": {"type": "string", "minLength": 3},
          "englishGroup": {"enum": ["2к207", "2к202"]},
          "aliases": {
            "type": "array",
            "items": {"type": "string", "minLength": 3},
            "uniqueItems": true
          }
        }
      }
    }
  }
}
