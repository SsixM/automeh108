{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "schedule.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "generatedAt", "meta", "times", "lessons", "replacementRules"],
  "properties": {
    "schemaVersion": {"const": 1},
    "revision": {"type": "string", "minLength": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timezone", "weekAnchor", "firstWeekType", "group"],
      "properties": {
        "timezone": {"const": "Europe/Moscow"},
        "weekAnchor": {"type": "string", "format": "date"},
        "firstWeekType": {"enum": ["numerator", "denominator"]},
        "group": {"const": "108М"}
      }
    },
    "times": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pairNumber", "start", "end"],
        "properties": {
          "pairNumber": {"type": "integer", "minimum": 1, "maximum": 7},
          "start": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
          "end": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"}
        }
      }
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lessonId", "weekday", "pairNumber", "subjectId", "subject", "teacher", "room", "subgroup", "weekType", "service"],
        "properties": {
          "lessonId": {"type": "string", "minLength": 3},
          "weekday": {"type": "integer", "minimum": 1, "maximum": 5},
          "pairNumber": {"type": "integer", "minimum": 1, "maximum": 7},
          "subjectId": {"type": "string", "minLength": 2},
          "subject": {"type": "string", "minLength": 2},
          "teacher": {"type": "string"},
          "room": {"type": "string"},
          "subgroup": {"enum": ["all", "split", "2к207", "2к202"]},
          "subgroupOptions": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "teacher", "room"],
              "properties": {
                "id": {"enum": ["2к207", "2к202"]},
                "teacher": {"type": "string"},
                "room": {"type": "string"}
              }
            }
          },
          "weekType": {"enum": ["all", "numerator", "denominator"]},
          "service": {"type": "boolean"},
          "validFrom": {"type": "string", "format": "date"},
          "validTo": {"type": "string", "format": "date"}
        },
        "allOf": [
          {
            "if": {"properties": {"subgroup": {"const": "split"}}, "required": ["subgroup"]},
            "then": {"required": ["subgroupOptions"]}
          }
        ]
      }
    },
    "replacementRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "weekday", "pairNumber", "weekType", "originalLessonId", "newSubjectId", "newSubject", "newRoom"],
        "properties": {
          "ruleId": {"type": "string", "minLength": 3},
          "weekday": {"type": "integer", "minimum": 1, "maximum": 5},
          "pairNumber": {"type": "integer", "minimum": 1, "maximum": 7},
          "weekType": {"enum": ["all", "numerator", "denominator"]},
          "originalLessonId": {"type": "string", "minLength": 3},
          "newSubjectId": {"type": "string", "minLength": 2},
          "newSubject": {"type": "string", "minLength": 2},
          "newTeacher": {"type": "string"},
          "newRoom": {"type": "string"},
          "validFrom": {"type": "string", "format": "date"},
          "validTo": {"type": "string", "format": "date"}
        }
      }
    }
  }
}
