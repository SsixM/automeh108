{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "duties.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "generatedAt", "group", "students", "days"],
  "properties": {
    "schemaVersion": {"const": 1},
    "revision": {"type": "string", "minLength": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "group": {"const": "108М"},
    "students": {
      "type": "object",
      "propertyNames": {"pattern": "^s[0-9]{2}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "count"],
        "properties": {
          "name": {"type": "string", "minLength": 3},
          "count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "selected", "selectedNames", "actual", "actualNames", "reports", "status", "seed", "algorithmVersion", "closed"],
        "properties": {
          "date": {"type": "string", "format": "date"},
          "selected": {"type": "array", "items": {"type": "string", "pattern": "^s[0-9]{2}$"}, "minItems": 2, "maxItems": 2, "uniqueItems": true},
          "selectedNames": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2},
          "actual": {"type": "array", "items": {"type": "string", "pattern": "^s[0-9]{2}$"}, "uniqueItems": true},
          "actualNames": {"type": "array", "items": {"type": "string"}},
          "reports": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["reportId", "userId", "receivedAt", "status", "studentIds", "studentNames", "ambiguous", "messageHash"],
              "properties": {
                "reportId": {"type": "string", "minLength": 8},
                "userId": {"type": "integer"},
                "receivedAt": {"type": "string", "format": "date-time"},
                "status": {"enum": ["confirmed", "pending"]},
                "studentIds": {"type": "array", "items": {"type": "string", "pattern": "^s[0-9]{2}$"}, "uniqueItems": true},
                "studentNames": {"type": "array", "items": {"type": "string"}},
                "ambiguous": {"type": "array", "items": {"type": "string"}},
                "messageHash": {"type": "string", "minLength": 16}
              }
            }
          },
          "status": {"enum": ["selected", "awaiting-report", "reported", "pending", "closed", "closed-without-confirmation"]},
          "seed": {"type": "string", "minLength": 16},
          "algorithmVersion": {"type": "string", "minLength": 3},
          "closed": {"type": "boolean"},
          "closedAt": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
